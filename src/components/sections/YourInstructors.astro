---
import Title from "../ui/Title.astro";
import YourInstructorsCard from "../cards/YourInstructorsCard.astro";
---

<section id="your-instructors">
   <div class="auto-margin">
      <div id="your-instructors-head">
         <Title type="h2">Conoce a tus instructores</Title>
      </div>

      <div id="your-instructors-cards">
         <YourInstructorsCard
            instructorVideoFile="instructor-gabriela-presentation-compressed.mp4"
            instructor={{
               name: "Gabriela",
               job: "Profesional terapeuta, masajista y profesora",
               description: "Soy terapeuta y masajista, dicto cursos de la academia siendo uno de ellos el curso de iniciación en Reiki."
            }}
         />

         <YourInstructorsCard
            instructorVideoFile="instructor-karina-presentation-compressed.mp4"
            instructor={{
               name: "Karina",
               job: "Profesional en depilación y profesora",
               description:"Soy especialista en depilación con cera y dicto el curso de la misma especialidad."
            }}
         />

         <YourInstructorsCard
            instructorVideoFile="instructor-leonel-presentation.mp4"
            instructor={{
               name: "Leonel",
               job: "Profesional masajista",
               description:"Soy especialista en masajes descontracturantes y relajantes con técnica firme y dedicada."
            }}
         />
      </div>
   </div>
</section>

<style>
   #your-instructors {
      height: fit-content;
      padding-block: var(--gap-sections);
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: var(--background-color);

      .auto-margin {
         display: flex;
         flex-direction: column;
         align-items: stretch;
         gap: var(--gap-sections);

         #your-instructors-cards {
            display: grid;
            grid-template-rows: repeat(auto, 1fr);
            grid-template-columns: repeat(1, 1fr);
            gap: var(--gap-cards);
         }
      }
   }

   @media screen and (min-width: 1280px) {
      #your-instructors {
         .auto-margin {
            #your-instructors-head {
               h2 {
                  text-align: center;
               }
            }

            #your-instructors-cards {
               grid-template-columns: repeat(3, 1fr);
            }
         }
      }
   }
</style>
