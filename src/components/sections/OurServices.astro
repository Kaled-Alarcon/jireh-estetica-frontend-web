---
import ServiceCard from "../cards/ServiceCard.astro";
---

<section id="our-services">
   <div class="auto-margin">
      <ServiceCard
         title="Manicuría"
         description="Cuidado experto y diseño tendencia para tus manos."
         price="45.000"
         imageFile="manicure-service-image.jpg"
      />
      <ServiceCard
         title="Pedicuría"
         description="Salud, descanso, tratamiento y color para tus pies."
         price="45.000"
         imageFile="pedicure-service-image.jpg"
      />
      <ServiceCard
         title="Peluquería"
         description="Cortes, color y nutrición para un cabello radiante."
         price="45.000"
         imageFile="hairsalon-service-image.jpg"
      />
      <ServiceCard
         title="Masajes"
         description="Relax profundo para liberar tensiones y renovarte."
         price="45.000"
         imageFile="massages-service-image.jpg"
      />
      <ServiceCard
         title="Depilación"
         description="Suavidad total y cuidado delicado de tu piel."
         price="45.000"
         imageFile="depilation-service-image.jpg"
      />
      <ServiceCard
         title="Limpieza facial"
         description="Piel sana, libre de impurezas, radiante y luminosa."
         price="45.000"
         imageFile="facialtratment-service-image.jpg"
      />
   </div>
</section>

<style>
   #our-services {
      height: fit-content;
      padding-block: var(--gap-sections);
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: var(--background-color);

      .auto-margin {
         display: grid;
         grid-template-rows: repeat(auto, 1fr);
         grid-template-columns: repeat(1, 1fr);
         gap: var(--gap-cards);
      }
   }

   @media screen and (min-width: 1280px) {
      #our-services {
         .auto-margin {
            grid-template-columns: repeat(3, 1fr);
         }
      }
   }
</style>
