---
import { base } from "astro:config/server";

import Title from "../ui/Title.astro";
import Text from "../ui/Text.astro";
import VideoPlayer from "../ui/VideoPlayer.astro";

interface Props {
   instructorVideoFile: string;
   instructor: {
      name: string;
      job: string;
      description: string;
   };
}

const { instructorVideoFile, instructor } = Astro.props;
---

<div class="your-instructors-card">
   <VideoPlayer videoFile={instructorVideoFile} width="auto" height="400px" />
   <div class="your-instructors-card-text">
      <Title type="h5">{instructor.name}</Title>
      <Title type="h6">{instructor.job}</Title>
      <Text>{instructor.description}</Text>
   </div>
</div>

<style>
   .your-instructors-card {
      height: fit-content;
      padding: var(--gap);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--gap-cards);

      .your-instructors-card-text {
         display: flex;
         flex-direction: column;
         gap: calc(var(--gap) / 2);

         h6 {
            color: var(--primary-color);
         }
      }
   }
</style>
